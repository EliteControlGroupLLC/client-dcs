NEXT_PUBLIC_SITE_URL=https://www.truthcoredevelopers.com

NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=
NEXT_PUBLIC_ATTOM_API_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_ZONEOMICS_API_KEY=

# RentCast key is used server-side only (via /api/property-valuation), so it
# should NOT be a NEXT_PUBLIC_ var (that exposes it in the client bundle).
# Set RENTCAST_API_KEY; NEXT_PUBLIC_RENTCAST_API_KEY is still read as a fallback.
RENTCAST_API_KEY=

REGRID_API_KEY=
CRON_SECRET=

# BuildCore CRM intake (server-only). Leads from Build Your ADU + report PDF.
BUILDCORE_INTAKE_URL=https://www.buildcoreus.ai/api/intake/consultations
BUILDCORE_INTAKE_SECRET=

# Twilio Verify (phone codes on Build Your ADU). Server-only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Signs the "phone verified" proof. Falls back to TWILIO_AUTH_TOKEN if unset.
VERIFICATION_TOKEN_SECRET=
